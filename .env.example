# Copy to .env and adjust as needed. Values here match docker-compose.yml
# exactly so `make up` works out of the box for local development.

ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=seatlock
POSTGRES_PASSWORD=seatlock_local_dev
POSTGRES_DB=seatlock
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://seatlock:seatlock_local_dev@localhost:5432/seatlock

REDIS_URL=redis://localhost:6379/0

# Which SeatAcquisitionStrategy to run. "naive", "pessimistic", or
# "optimistic".
STRATEGY=naive
# Widens the naive strategy's read-then-write race window (milliseconds)
# so its oversell is reproducible on demand. 0 = real but timing-dependent.
NAIVE_RACE_WINDOW_MS=0
HOLD_DURATION_SECONDS=480

# See app/infra/config.py's comment: workers * (pool_size + max_overflow)
# must stay below postgres max_connections (default 100).
UVICORN_WORKERS=4
POOL_SIZE=10
MAX_OVERFLOW=5

# How long a blocked pessimistic-locking acquire waits before failing
# cleanly (503) instead of hanging.
PESSIMISTIC_LOCK_TIMEOUT_MS=5000
# Shared between this process and the Makefile's run-api target, which
# clears it exactly once before starting uvicorn -- see
# app/infra/metrics.py's module docstring.
PROMETHEUS_MULTIPROC_DIR=.prometheus-multiproc

# Optimistic strategy (Strategy C) retry policy -- see
# app/inventory/strategies/optimistic.py.
OPTIMISTIC_BACKOFF_BASE_SECONDS=0.05
OPTIMISTIC_MAX_ATTEMPTS=5
# Full jitter vs. fixed backoff -- flipped by loadtest/run_benchmark.py's
# jitter ablation, not normally changed by hand.
OPTIMISTIC_FULL_JITTER=true

# Hold sweeper (workers/sweeper.py). 5s is SPEC.md's production guidance
# (5-10s) -- these are PRODUCT defaults, safe because lazy expiry at the
# query layer is the actual enforcement mechanism (Phase 4); the sweeper
# is cleanup, not correctness. The Phase 3 recirculating benchmark
# overrides both to much shorter values via its own env, never by editing
# this file -- see app/infra/config.py's comment for why.
SWEEPER_INTERVAL_SECONDS=5.0
SWEEPER_BATCH_SIZE=100

# Reconciler (workers/reconciler.py) -- repairs Redis/Postgres divergence
# in the hold mirror. SPEC.md section 5 says "every few minutes"; 60s here
# is more frequent for faster feedback in development.
RECONCILER_INTERVAL_SECONDS=60.0

# Idempotency (workers/idempotency_reaper.py, SPEC.md section 6).
IDEMPOTENCY_STALE_TIMEOUT_SECONDS=60.0
IDEMPOTENCY_REAPER_INTERVAL_SECONDS=30.0
IDEMPOTENCY_REAPER_BATCH_SIZE=100
IDEMPOTENCY_KEY_TTL_SECONDS=86400.0

# Payment webhooks (app/payments/, workers/payment_worker.py, SPEC.md
# section 7). INSECURE PLACEHOLDER -- override in any real deployment.
WEBHOOK_HMAC_SECRET=dev-webhook-secret-change-me
PAYMENT_WORKER_INTERVAL_SECONDS=5.0
PAYMENT_WORKER_BATCH_SIZE=100
